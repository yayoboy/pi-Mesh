[Desktop Entry]
Type=Application
Name=pi-Mesh
Comment=Terminale Meshtastic
# App mode: finestra propria senza barra indirizzi, non una scheda del browser.
# Il servizio pimesh serve la UI, qui si apre soltanto la finestra.
#
# Exec non è una riga di shell: ' | && ; $ sono caratteri riservati dalla
# specifica e XFCE si rifiuta di avviare senza dire niente. Niente catena di
# fallback, quindi: setup.sh riscrive questa riga col browser che la macchina
# ha davvero (chromium-browser su Raspberry Pi OS, chromium su Debian e
# Ubuntu, xdg-open dove non c'è nessuno dei due).
Exec=chromium --app=http://localhost:8080 --window-size=1024,600
Icon=network-wireless
Terminal=false
Categories=Network;HamRadio;
